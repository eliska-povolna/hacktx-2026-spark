# Mock mode keeps the preview self-contained. Flip to false once the
# backend is reachable (and your frontend origin is in its CORS_ORIGINS).
VITE_USE_MOCK_API=true
# Production backend (FastAPI runs internally on the server; Caddy exposes
# only HTTPS — port 8000 is NOT publicly open, never use the raw IP:8000).
VITE_API_BASE_URL=https://questmaster.tech/api
# Local backend development:
# VITE_API_BASE_URL=http://localhost:8000/api
