# QuestMaster frontend environment (copy to .env for local overrides).
# .env is git-ignored — never commit real values.

# "true" = built-in demo data, "false" = live backend (default: false)
VITE_USE_MOCK_API=false

# Live backend (FastAPI behind Caddy; only HTTPS is exposed publicly)
VITE_API_BASE_URL=https://questmaster.tech/api
